# ==============================================================================
# MicroReach AI — Environment Configuration Template
# Copy needed frontend VITE_* values to .env.local for local Vite development.
# Configure server-side secrets in Google AI Studio Secrets (or .env.local locally).
# NEVER put private server secrets into VITE_* variables!
# ==============================================================================

# Public Frontend Supabase Configuration (browser-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Application URL (injected in AI Studio runtime or set locally)
APP_URL=

# ==============================================================================
# SERVER-ONLY SECRETS (NEVER prefix with VITE_)
# ==============================================================================

# Supabase Admin Backend (bypasses RLS strictly after server session checks)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Link-Based Shared Demo Access
DEMO_ACCESS_TOKEN=
DEMO_SESSION_SECRET=

# YouTube Data API v3 (Server-side Creator Discovery)
YOUTUBE_API_KEY=

# Apify Instagram Discovery (Server-side Creator Discovery)
APIFY_TOKEN=

# Gemini AI SDK (Server-side Personalized Outreach Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Outreach Mode ("simulation" default; switch to "live" only after Gmail OAuth setup)
OUTREACH_MODE=simulation

# Gmail OAuth 2.0 (Optional — required only for live Gmail sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
INTEGRATION_ENCRYPTION_KEY=
